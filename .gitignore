.project
.factorypath
/bin/

# Windows / macOS file manager metadata
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Local secrets and overrides
.env
.env.local

# Generated PDF/Excel output belongs in exports/, generated/ or target/.
# Do not globally ignore *.pdf, *.xlsx or *.sql: reference documents,
# import fixtures, migrations and required resources must remain trackable.

# Compose Desktop build output
**/.gradle/
**/build/
**/.kotlin/

# Local Python maintenance-tool cache
/tools/__pycache__/

# Publication: machine-local tooling and generated artifacts
/graphify-out/
/.codex/
/outputs/
**/node_modules/
**/__pycache__/
*.py[cod]

# Local SQLite files and backups; intentional resource fixtures remain versionable
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
**/backups/
*.bak
!**/src/test/resources/**/*.db
!**/src/test/resources/**/*.sqlite
!**/src/test/resources/**/*.sqlite3
!**/src/test/resources/**/*.bak

!**/src/main/resources/**/*.db
!**/src/main/resources/**/*.sqlite
!**/src/main/resources/**/*.sqlite3

