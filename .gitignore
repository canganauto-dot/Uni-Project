# Maven / Java / desktop packaging output
/target/
**/target/
/out/
/build/
/dist/
*.class
*.log
hs_err_pid*
replay_pid*
.java_pid*

# Local application data and generated exports (keep source resources trackable)
/data/
/exports/
/generated/
*-journal
*-wal
*-shm

# IDE and editor machine state
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
